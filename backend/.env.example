# --- Database ---
# PostgreSQL (default for local Docker/production-like setups — see docker-compose.yml):
DATABASE_URL=postgresql+psycopg://bims_user:bims_password@localhost:5432/bims_db
# SQLite alternative (zero-setup local dev — see README "Quick Start").
# Uncomment to use instead of the line above:
# DATABASE_URL=sqlite:///./dev.db

SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
UPLOAD_FOLDER=app/uploads
MAX_UPLOAD_SIZE=10485760
APP_NAME=BIMS
DEBUG=true
CORS_ORIGINS=http://localhost:5173
