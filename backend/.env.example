# --- Database ---
# PostgreSQL (default for local Docker/production-like setups — see docker-compose.yml):
DATABASE_URL=postgresql+psycopg://bims_user:bims_password@localhost:5432/bims_db
# SQLite alternative (zero-setup local dev — see README "Quick Start").
# Uncomment to use instead of the line above:
# DATABASE_URL=sqlite:///./dev.db

SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
UPLOAD_FOLDER=app/uploads
MAX_UPLOAD_SIZE=10485760
APP_NAME=BIMS
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Task 4: outbound notification channels (all OPTIONAL) ---
# The app is fully functional with none of these set. In-app notifications
# always work; email/WhatsApp are best-effort extras that are silently
# skipped when disabled, and never fail the action that triggered them.
# Absolute links inside outbound email/WhatsApp messages point here:
FRONTEND_BASE_URL=http://localhost:5173

# --- Email (SMTP) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, and
# SMTP_PASSWORD must be a 16-character Google "App Password" generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# A normal Gmail account password will NOT authenticate.
# Never commit real credentials — backend/.env is gitignored, this file is not.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# Requires a Meta Business account, a registered WhatsApp phone number, a
# permanent access token, and an APPROVED message template (business-initiated
# messages cannot be free-form). Requires `pip install httpx`.
# See NOTIFICATIONS.md for the full setup walkthrough.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TIMEOUT_SECONDS=10
