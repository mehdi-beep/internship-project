"""Proposed Vision AI pipeline for the future AI-assisted approval module.

Illustrative only — see SPECIFICATION.md Section 6 for the full design rationale.
"""

from dataclasses import dataclass
from enum import Enum


class ImageQuality(str, Enum):
    """Distinct from a comparison mismatch — see docs/confidence_scoring.md's
    'three possible states per field' section for why this matters."""
    USABLE = "usable"
    TOO_BLURRY = "too_blurry"
    TOO_DARK = "too_dark"


@dataclass
class VisionFindings:
    image_quality: ImageQuality
    signature_detected: bool
    signature_confidence: float  # 0.0-1.0


def assess_image_quality(raw_image_bytes: bytes) -> ImageQuality:
    """PROPOSED: fast blur/brightness/contrast checks, run BEFORE OCR so a
    genuinely unusable photo is flagged immediately rather than silently producing
    an unreliable downstream result (SPECIFICATION.md Section 6, step 2).
    """
    raise NotImplementedError("Prototype only — see SPECIFICATION.md Section 6.")


def detect_signature(preprocessed_image, expected_region: dict) -> tuple[bool, float]:
    """PROPOSED: a lightweight region-classification model answering "is there
    ink/a mark in this specific expected region," since the signature location on
    the paper BI form is fixed by the template (SPECIFICATION.md Section 6, step 1).

    Returns (signature_detected, confidence).
    """
    raise NotImplementedError("Prototype only — see SPECIFICATION.md Section 6.")


def run_vision_pipeline(raw_image_bytes: bytes, form_layout: dict) -> VisionFindings:
    """The proposed entry point tying the vision checks together."""
    quality = assess_image_quality(raw_image_bytes)
    if quality != ImageQuality.USABLE:
        # PROPOSED: short-circuit — do not attempt signature detection on an
        # already-flagged-unusable image.
        return VisionFindings(image_quality=quality, signature_detected=False, signature_confidence=0.0)

    detected, confidence = detect_signature(raw_image_bytes, form_layout.get("signature_region", {}))
    return VisionFindings(image_quality=quality, signature_detected=detected, signature_confidence=confidence)
