# The doubled /api/api is intentional, not a typo. cPanel's Passenger
# mount for the backend (PassengerBaseURI "/api" in BI/api/.htaccess)
# strips one /api segment before forwarding to FastAPI -- but FastAPI's
# own routes already include /api internally (see main.py's
# include_router(..., prefix="/api") calls). Without the extra segment
# here, every request 404s since FastAPI never sees the /api it expects.
VITE_API_URL=https://bi.cortextechnology.ma/api/api
