"""Proposed API router for the future, standalone AI-review service.

Illustrative only — see SPECIFICATION.md Section 10 for the endpoint design
rationale. This is deliberately NOT written to be included via
`app.include_router(...)` in the real backend/main.py — if this module is ever
actually built, it would be the entry point of its OWN separate FastAPI
application, deployed independently (see SPECIFICATION.md Section 3's
architecture diagram).
"""

from fastapi import APIRouter

# Deliberately NOT prefixed with "/api" — this illustrates that even if this
# were ever deployed, its route namespace is designed to never collide with
# the real application's existing /api/* routes.
router = APIRouter(prefix="/ai-review", tags=["ai-review-prototype"])


@router.post("/analyze/{intervention_id}")
def analyze_intervention(intervention_id: int):
    """PROPOSED: trigger analysis for a given intervention's attachment(s).
    Would fetch the digital form read-only from the real BIMS API, run the
    OCR + Vision + Comparison pipelines, and return a job ID for polling
    (analysis is expected to be too slow for a synchronous response).
    """
    raise NotImplementedError("Prototype only — see SPECIFICATION.md Section 10.")


@router.get("/result/{job_id}")
def get_analysis_result(job_id: str):
    """PROPOSED: poll for the full structured result once the job completes."""
    raise NotImplementedError("Prototype only — see SPECIFICATION.md Section 10.")


@router.get("/result/{job_id}/explanation")
def get_explanation_only(job_id: str):
    """PROPOSED: fetch just the human-readable explanation text, for a
    lightweight UI panel that doesn't need every raw field-comparison result.
    """
    raise NotImplementedError("Prototype only — see SPECIFICATION.md Section 10.")
